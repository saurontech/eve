+CONFIG_EFI_PARTITION_ENTRIES_NUMBERS=128
+CONFIG_EFI_PARTITION_ENTRIES_OFF=0
+CONFIG_SPL_EFI_PARTITION=y
+# SMBIOS, so GRUB's rootfs.cfg can match vendor/product; mirroring 0016
+CONFIG_SYSINFO=y
+CONFIG_SYSINFO_SMBIOS=y
+# Package OP-TEE into flash.bin; mirroring 0021. Keep this even though the
+# U-Boot-side OP-TEE driver above is off: it is what makes the FIT reference
+# bl31-tee.bin and what selects BINMAN (patches 0007/0011/0020).
+CONFIG_OPTEE_FIRMWARE_SET=y
+CONFIG_OPTEE_FIRMWARE="tee.bin"
+# 4GB DRAM layout instead of the EVK's 3GB+3GB
+CONFIG_IMX8MP_ECU150V2_DRAM_4G=y
+# Measured boot, so EVE can seal its vault key.
+#
+# pkg/pillar/evetpm/tpm.go:1247-1251 refuses to seal while PCR 0 or PCR 4 is
+# all-zero in the SHA-256 bank. U-Boot's EFI_TCG2_PROTOCOL is what extends
+# them on this board: EV_S_CRTM_VERSION into PCR 0 and the loaded
+# BOOTAA64.EFI into PCR 4, both on the bootefi path this defconfig uses.
+#
+# TPM2_TIS_I2C is the backport in patch 0028 -- lf_v2022.04 ships only the SPI
+# and MMIO TPM2 drivers, and this board's SLB9673 is on I2C2 (see the DTS
+# above). TPM_V2 (drivers/tpm/Kconfig:120) and EFI_TCG2_PROTOCOL
+# (lib/efi_loader/Kconfig:309) are both "default y" once TPM is on; they are
+# spelled out here because this defconfig is hand-maintained, not generated by
+# savedefconfig, so an implicit dependency would be invisible.
+CONFIG_TPM=y
+CONFIG_TPM_V2=y
+CONFIG_TPM2_TIS_I2C=y
+CONFIG_EFI_TCG2_PROTOCOL=y
+# 'tpm2 init ; tpm2 startup TPM2_SU_CLEAR ; tpm2 pcr_read 0' at the U-Boot
+# prompt is the only way to confirm the measurements without booting into
+# pillar. EFI_TCG2_PROTOCOL selects SHA1/SHA256/SHA384/SHA512/HASH and
+# SMBIOS_PARSER, which grows u-boot.bin; watch the binman output for overflow.
+CONFIG_CMD_TPM=y
diff --color -urN a/include/configs/imx8mp_evk.h b/include/configs/imx8mp_evk.h
--- a/include/configs/imx8mp_evk.h	2026-08-31 17:53:45.200748155 +0800
+++ b/include/configs/imx8mp_evk.h	2026-08-31 17:54:17.419429224 +0800
@@ -196,6 +196,21 @@
 
 #define CONFIG_MMCROOT			"/dev/mmcblk1p2"  /* USDHC2 */
 
+#ifdef CONFIG_IMX8MP_ECU150V2_DRAM_4G
+/*
+ * Advantech ECU-150v2: 4GB, as two contiguous 2GB banks starting at
+ * 0x40000000. The stock EVK layout below is 3GB + 3GB with the second bank at
+ * 0x100000000; leaving it in place makes dram_init() report 6 GiB on this
+ * board (the weak board_phys_sdram_size() in arch/arm/mach-imx/imx8m/soc.c
+ * just sums these two defines), and the kernel would then be handed a memory
+ * map extending past the end of physical DRAM.
+ */
+#define CONFIG_SYS_SDRAM_BASE		0x40000000
+#define PHYS_SDRAM			0x40000000
+#define PHYS_SDRAM_SIZE			0x80000000	/* 2 GB */
+#define PHYS_SDRAM_2			0xC0000000
